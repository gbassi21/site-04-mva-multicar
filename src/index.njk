---
layout: layouts/base.njk
titulo: Seminovos e usados em Jacaraípe, Serra (ES)
precarregar: hero-entrega
carroHero: ford-ranger-limited-2018
---
{% from "macros.njk" import tituloSecao, cardServico %}
{%- set veiculos = collections.veiculos %}
{%- set carro = veiculos | buscarVeiculo(carroHero) %}
{%- set tipos = [
  { valor: "hatch", nome: "Hatch" },
  { valor: "seda", nome: "Sedã" },
  { valor: "suv", nome: "SUV" },
  { valor: "picape", nome: "Picape" }
] %}

<section class="hero" aria-labelledby="titulo-hero">
  <div class="envoltorio hero__grade">
    <div class="hero__texto">
      <h1 class="hero__titulo" id="titulo-hero">Seu próximo carro, perto de casa</h1>
      <p class="hero__sub">Seminovos e usados multimarcas em Jacaraípe, Serra (ES). Compra, venda, troca e financiamento.</p>
      <form class="busca" action="/estoque/" method="get" role="search">
        <label class="vh" for="busca-hero">Buscar por marca ou modelo</label>
        {{ icone("search", "busca__icone") | safe }}
        <input class="busca__campo" id="busca-hero" name="q" type="search" placeholder="Marca ou modelo" autocomplete="off" enterkeyhint="search">
        <button class="botao botao--primario busca__botao" type="submit">Buscar</button>
      </form>
      <nav class="hero__pilulas" aria-label="Atalhos">
        <a class="pilula" href="/estoque/">{{ icone("car-front") | safe }}Comprar</a>
        <a class="pilula" href="/vender-ou-trocar/">{{ icone("hand-coins") | safe }}Vender</a>
        <a class="pilula" href="/vender-ou-trocar/#troca">{{ icone("arrow-left-right") | safe }}Trocar</a>
      </nav>
    </div>

    <div class="hero__vitrine">
      {{ tracos("hero__tracos") | safe }}
      <div class="hero__quadro">
        {%- if temIlustracao("hero-entrega") %}
        {{ ilustracao("hero-entrega", "(min-width: 1024px) 60vw, 100vw", true) | safe }}
        {%- elif carro %}
        {# Até imagens-ia/ia-hero-entrega.png existir, o hero mostra a capa de estúdio do carro de carroHero. #}
        {{ fotoVeiculo(carro.page.fileSlug + "/01-capa.png", carro.data.nome + " " + carro.data.anoTexto + " (imagem ilustrativa)", "(min-width: 1024px) 60vw, 100vw", true) | safe }}
        <span class="etiqueta">Imagem ilustrativa</span>
        {%- endif %}
      </div>
      {%- if carro and not temIlustracao("hero-entrega") %}
      <a class="hero__carro" href="{{ carro.url }}">
        <span class="hero__carro-nome">{{ carro.data.nome }} {{ carro.data.anoTexto }}</span>
        <span class="hero__carro-preco">{{ carro.data.preco | reais }}</span>
        <span class="hero__carro-acao">Ver o carro{{ icone("arrow-right") | safe }}</span>
      </a>
      {%- endif %}
    </div>
  </div>
</section>

<section class="faixa faixa--branca" aria-labelledby="titulo-servicos">
  <div class="envoltorio">
    <h2 class="vh" id="titulo-servicos">Serviços</h2>
    <ul class="servicos">
      <li>{{ cardServico({ url: "/vender-ou-trocar/", imagem: "card-avaliacao", tom: "vermelho", icone: "hand-coins", titulo: "Quanto vale o seu carro?", texto: "Avaliação para venda ou troca, pelo WhatsApp.", acao: "Avaliar meu carro" }) }}</li>
      <li>{{ cardServico({ url: "/financiamento/", imagem: "card-financiamento", tom: "grafite", icone: "landmark", titulo: "Financiamento", texto: "Financiamento via banco para o carro que você escolher. Tire as dúvidas pelo WhatsApp.", acao: "Como funciona" }) }}</li>
      <li>{{ cardServico({ url: "/oficina/", imagem: "card-oficina", tom: "preto", icone: "wrench", titulo: "Cuide do seu carro", texto: "A oficina MVA Centro Automotivo fica ao lado da loja: mecânica geral, alinhamento 3D e pneus.", acao: "Conhecer a oficina" }) }}</li>
    </ul>

    <ul class="confianca" aria-label="Por que a MVA">
      <li class="confianca__item">
        <span class="confianca__icone">{{ icone("wrench") | safe }}</span>
        <div>
          <h3 class="confianca__titulo">Oficina própria ao lado, desde {{ loja.oficina.desde }}</h3>
        </div>
      </li>
      <li class="confianca__item">
        <span class="confianca__icone">{{ icone("arrow-left-right") | safe }}</span>
        <div>
          <h3 class="confianca__titulo">Seu carro entra na troca</h3>
        </div>
      </li>
      <li class="confianca__item">
        <span class="confianca__icone">{{ icone("whatsapp") | safe }}</span>
        <div>
          <h3 class="confianca__titulo">Atendimento pelo WhatsApp</h3>
          <p>Fale direto com a loja: <a href="{{ wa(loja.mensagens.geral) }}" target="_blank" rel="noopener">{{ loja.whatsapp.exibicao }}</a>.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<section class="faixa faixa--cinza" id="carros" aria-labelledby="titulo-vitrine">
  <div class="envoltorio">
    {{ tituloSecao("titulo-vitrine", "Carros à venda", "Valores de " + loja.valoresEm + ", sujeitos a alteração.", "/estoque/", "Ver todo o estoque") }}

    {% include "partials/vitrine.njk" %}
  </div>
</section>

<section class="faixa faixa--branca" aria-labelledby="titulo-tipos">
  <div class="envoltorio">
    {{ tituloSecao("titulo-tipos", "Explore por tipo") }}
    <ul class="tipos">
      {%- for t in tipos %}
      {%- set qtd = veiculos | contarCarroceria(t.valor) %}
      <li>
        <a class="tipo" href="/estoque/?carroceria={{ t.valor }}">
          {{ carroceria(t.valor, "tipo__silhueta") | safe }}
          <span class="tipo__nome">{{ t.nome }}</span>
          {% if qtd %}<span class="tipo__qtd">{{ qtd }} {{ "carro" if qtd == 1 else "carros" }}</span>{% endif %}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="faixa faixa--preta oficina" id="oficina" aria-labelledby="titulo-oficina">
  <div class="envoltorio oficina__grade">
    <div class="oficina__texto">
      <h2 class="titulo-secao titulo-secao--claro" id="titulo-oficina">{{ tracos("titulo-secao__tracos") | safe }}<span class="titulo-secao__texto">Cuide do seu carro</span></h2>
      <p class="oficina__lead">Na {{ loja.oficina.nome }}, a oficina do grupo, ao lado da loja. Mecânica geral e os serviços do dia a dia do seu carro.</p>
      <ul class="oficina__info">
        <li>{{ icone("map-pin") | safe }}<span>{{ loja.oficina.endereco }}, {{ loja.oficina.referencia }}</span></li>
        <li>{{ icone("clock") | safe }}<span>{{ loja.oficina.horario }}</span></li>
        <li>{{ icone("star") | safe }}<span>Nota {{ loja.oficina.google.nota }} no Google, com {{ loja.oficina.google.avaliacoes }} avaliações. <a href="{{ loja.oficina.google.link }}" target="_blank" rel="noopener">Ver no Google</a></span></li>
      </ul>
      <div class="oficina__acoes">
        <a class="botao botao--primario botao--grande" href="{{ wa(loja.mensagens.oficina, loja.oficina.whatsapp.numero) }}" target="_blank" rel="noopener">{{ icone("whatsapp") | safe }}Agendar: {{ loja.oficina.whatsapp.exibicao }}</a>
        <a class="botao botao--contorno-claro" href="{{ loja.oficina.instagram.link }}" target="_blank" rel="noopener">{{ icone("instagram") | safe }}{{ loja.oficina.instagram.usuario }}</a>
      </div>
    </div>
    <ul class="oficina__servicos" aria-label="Serviços da oficina">
      {%- for s in loja.oficina.servicos %}
      <li>
        <a class="servico" href="{{ wa(loja.mensagens.oficina + s.nome, loja.oficina.whatsapp.numero) }}" target="_blank" rel="noopener">
          {{ icone(s.icone, "servico__icone") | safe }}
          <span class="servico__nome">{{ s.nome }}</span>
          <span class="servico__acao">Agendar{{ icone("arrow-right") | safe }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="faixa faixa--cinza" aria-labelledby="titulo-como">
  <div class="envoltorio como">
    <div class="como__intro">
      <h2 class="titulo-secao" id="titulo-como">{{ tracos("titulo-secao__tracos") | safe }}<span class="titulo-secao__texto">Como funciona</span></h2>
      <a class="link-acao" href="/estoque/">Ver os carros{{ icone("arrow-right") | safe }}</a>
    </div>
    <ol class="passos">
      <li class="passo">
        <span class="passo__numero" aria-hidden="true">1</span>
        {{ icone("search", "passo__icone") | safe }}
        <h3 class="passo__titulo">Escolha no site</h3>
        <p>Fotos, preço, ano e km de cada carro, com o WhatsApp da loja a um toque.</p>
      </li>
      <li class="passo">
        <span class="passo__numero" aria-hidden="true">2</span>
        {{ icone("landmark", "passo__icone") | safe }}
        <h3 class="passo__titulo">Financie ou dê seu carro na troca</h3>
        <p>O financiamento é via banco, e o seu carro pode entrar no negócio.</p>
      </li>
      <li class="passo">
        <span class="passo__numero" aria-hidden="true">3</span>
        {{ icone("key-round", "passo__icone") | safe }}
        <h3 class="passo__titulo">Retire com o laço vermelho</h3>
        <p>Na entrega, o carro sai da loja com o laço vermelho no capô.</p>
      </li>
    </ol>
  </div>
</section>

{#- Avaliações (specs/site.md, specs/design.md §6): a nota real de cada unidade, sempre visível, e, se houver
    chave da API do Google em loja.googleMaps.chave, os comentários de 5 estrelas com texto, carregados ao vivo
    do Google Maps quando a seção aparece. Sem chave, ou se o Google não responder, fica só a nota. -#}
<section class="faixa faixa--branca" aria-labelledby="titulo-avaliacoes" data-comentarios-google{% if loja.googleMaps.chave %} data-chave="{{ loja.googleMaps.chave }}"{% endif %} data-por-unidade="{{ loja.googleMaps.comentariosPorUnidade }}">
  <div class="envoltorio">
    {{ tituloSecao("titulo-avaliacoes", "Avaliações no Google", "Notas reais da loja e da oficina, consultadas em " + loja.notasEm + ".") }}
    <ul class="avaliacoes">
      {%- for u in [
        { chave: "loja", nome: "Loja MVA Multicar", icone: "store", g: loja.google, busca: loja.googleMaps.buscaLoja },
        { chave: "oficina", nome: "Oficina MVA Centro Automotivo", icone: "wrench", g: loja.oficina.google, busca: loja.googleMaps.buscaOficina }
      ] %}
      <li class="avaliacao" data-lugar="{{ u.busca }}">
        <p class="avaliacao__unidade">{{ icone(u.icone) | safe }}{{ u.nome }}</p>
        <div class="avaliacao__nota">
          <span class="avaliacao__numero" data-nota>{{ u.g.nota }}</span>
          <span class="estrelas" style="--nota: {{ u.g.valor }}" role="img" aria-label="Nota {{ u.g.nota }} de 5" data-estrelas>
            <span class="estrelas__base">{% for i in range(5) %}{{ icone("star", "estrela") | safe }}{% endfor %}</span>
            <span class="estrelas__cheias">{% for i in range(5) %}{{ icone("star", "estrela") | safe }}{% endfor %}</span>
          </span>
        </div>
        <p class="avaliacao__qtd"><span data-qtd>{{ u.g.avaliacoes }}</span> avaliações no Google</p>
        {#- Depoimentos autorizados (referencias/pedido-do-cliente.md); os comentários ao vivo, se vierem, tomam o lugar deles. -#}
        {%- set depoimentos = loja.depoimentos | selectattr("unidade", "equalto", u.chave) | list %}
        <ul class="comentarios" data-lista-comentarios aria-label="Comentários de 5 estrelas sobre a {{ u.nome }}"{% if not depoimentos.length %} hidden{% endif %}>
          {%- for d in depoimentos %}
          <li class="comentario">
            <div class="comentario__topo"><span class="comentario__inicial" aria-hidden="true">{{ d.nome | first }}</span><span class="comentario__quem"><span class="comentario__autor">{{ d.nome }}</span><span class="comentario__quando">no Google Maps</span></span></div>
            <span class="estrelas estrelas--pequenas" style="--nota: 5" role="img" aria-label="5 de 5 estrelas">
              <span class="estrelas__base">{% for i in range(5) %}{{ icone("star", "estrela") | safe }}{% endfor %}</span>
              <span class="estrelas__cheias">{% for i in range(5) %}{{ icone("star", "estrela") | safe }}{% endfor %}</span>
            </span>
            <p class="comentario__texto">{{ d.texto }}</p>
          </li>
          {%- endfor %}
        </ul>
        <a class="link-acao" href="{{ u.g.link }}" target="_blank" rel="noopener" data-link-google>Ver todas no Google{{ icone("external-link") | safe }}</a>
      </li>
      {%- endfor %}
    </ul>
    <p class="comentarios__fonte" data-fonte-comentarios{% if not loja.depoimentos.length %} hidden{% endif %}>Avaliações de 5 estrelas publicadas no Google Maps, reproduzidas com autorização dos autores. A nota acima considera todas as avaliações.</p>
  </div>
</section>

<section class="faixa faixa--vermelha cta" aria-labelledby="titulo-cta">
  {{ tracos("cta__tracos") | safe }}
  <div class="envoltorio cta__grade">
    <div class="cta__texto">
      <h2 class="cta__titulo" id="titulo-cta">Quer vender ou trocar o seu carro?</h2>
      <p>Mande marca, modelo, ano e km pelo WhatsApp e receba a proposta de compra ou de troca.</p>
    </div>
    <a class="botao botao--branco botao--grande" href="{{ wa(loja.mensagens.avaliacao) }}" target="_blank" rel="noopener">{{ icone("whatsapp") | safe }}Avaliar meu carro</a>
  </div>
</section>
