{#- Vitrine filtrável (specs/site.md §3.2). Espera: veiculos, modoEstoque (true na página de estoque). -#}
{%- from "macros.njk" import cardVeiculo -%}
{%- set filtros = veiculos | opcoesFiltros %}
<form class="filtros{% if modoEstoque %} filtros--estoque{% endif %}" id="filtros-vitrine" action="/estoque/" method="get" data-filtros aria-label="Filtrar carros">
  {%- if modoEstoque %}
  <label class="campo campo--busca">
    <span class="campo__rotulo">Buscar por marca ou modelo</span>
    <span class="campo__busca">{{ icone("search") | safe }}<input type="search" name="q" placeholder="Ex.: Ranger, Volkswagen" autocomplete="off" enterkeyhint="search"></span>
  </label>
  {%- endif %}
  <fieldset class="filtros__tipos marcas">
    <legend class="vh">Marca</legend>
    <label class="marca" data-opcao-marca><input type="radio" name="marca" value="" checked><span class="marca__circulo marca__circulo--todas">{{ icone("car-front") | safe }}</span><span class="marca__nome">Todas</span><small class="marca__qtd">{{ veiculos.length }}</small></label>
    {%- for m in filtros.marcas %}
    {%- set logo = logosMarcas[m.valor] %}
    <label class="marca" data-opcao-marca><input type="radio" name="marca" value="{{ m.valor }}"><span class="marca__circulo">{% if logo %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="{{ logo.d }}"/></svg>{% else %}<span class="marca__texto">{{ m.nome }}</span>{% endif %}</span><span class="marca__nome">{{ m.nome }}</span><small class="marca__qtd">{{ m.qtd }}</small></label>
    {%- endfor %}
  </fieldset>
  <div class="filtros__campos">
    <label class="campo">
      <span class="campo__rotulo">Carroceria</span>
      <select name="carroceria"><option value="">Todas</option>{% for c in filtros.carrocerias %}<option value="{{ c.valor }}">{{ c.nome }}</option>{% endfor %}</select>
    </label>
    <label class="campo">
      <span class="campo__rotulo">Ano a partir de</span>
      <select name="ano"><option value="">Qualquer</option>{% for a in filtros.anos %}<option value="{{ a }}">{{ a }}</option>{% endfor %}</select>
    </label>
    <label class="campo">
      <span class="campo__rotulo">Câmbio</span>
      <select name="cambio"><option value="">Qualquer</option>{% for c in filtros.cambios %}<option value="{{ c.valor }}">{{ c.nome }}</option>{% endfor %}</select>
    </label>
    <label class="campo">
      <span class="campo__rotulo">Preço até</span>
      <select name="preco_max"><option value="">Qualquer</option>{% for p in filtros.precos %}<option value="{{ p }}">{{ p | reais }}</option>{% endfor %}</select>
    </label>
    {%- if modoEstoque %}
    <label class="campo">
      <span class="campo__rotulo">Ordenar por</span>
      <select name="ordem">
        <option value="">Mais novos primeiro</option>
        <option value="menor-preco">Menor preço</option>
        <option value="maior-preco">Maior preço</option>
        <option value="menor-km">Menor km</option>
      </select>
    </label>
    {%- endif %}
    <button class="botao botao--secundario filtros__enviar" type="submit">Filtrar</button>
    <button class="filtros__limpar" type="reset">{{ icone("rotate-ccw") | safe }}Limpar</button>
  </div>
  <p class="filtros__resultado" aria-live="polite" data-resultado>{{ veiculos.length }} {{ "carro" if veiculos.length == 1 else "carros" }}</p>
</form>

<ul class="vitrine{% if modoEstoque %} vitrine--grade{% endif %}" data-vitrine>
  {%- for v in veiculos %}
  <li class="vitrine__item" data-posicao="{{ loop.index0 }}">{{ cardVeiculo(v) }}</li>
  {%- endfor %}
  <li class="vitrine__item vitrine__item--fim">
    {%- if modoEstoque %}
    <a class="card-fim" href="{{ wa(loja.mensagens.procura) }}" target="_blank" rel="noopener">
      {{ tracos("card-fim__tracos") | safe }}
      <span class="card-fim__titulo">Não achou o carro que procura?</span>
      <span class="card-fim__texto">Conte para a loja pelo WhatsApp o modelo, o ano e quanto quer investir.</span>
      <span class="card-fim__seta">{{ icone("whatsapp") | safe }}</span>
    </a>
    {%- else %}
    <a class="card-fim" href="/estoque/">
      {{ tracos("card-fim__tracos") | safe }}
      <span class="card-fim__titulo">Ver todo o estoque</span>
      <span class="card-fim__texto">Várias marcas, do popular ao premium.</span>
      <span class="card-fim__seta">{{ icone("arrow-right") | safe }}</span>
    </a>
    {%- endif %}
  </li>
</ul>
<div class="vitrine__vazia" data-vazio hidden>
  <p><strong>Nenhum carro com esses filtros.</strong> Mude os filtros ou conte para a loja o que você procura.</p>
  <div class="vitrine__vazia-acoes">
    <button class="botao botao--secundario" type="reset" form="filtros-vitrine">{{ icone("rotate-ccw") | safe }}Limpar filtros</button>
    <a class="botao botao--primario" href="{{ wa(loja.mensagens.procura) }}" target="_blank" rel="noopener">{{ icone("whatsapp") | safe }}Contar o que procuro</a>
  </div>
</div>
