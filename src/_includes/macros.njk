{% macro tituloSecao(id, texto, sub = "", link = "", textoLink = "") %}
<div class="secao__topo">
  <div class="secao__titulos">
    <h2 class="titulo-secao" id="{{ id }}">{{ tracos("titulo-secao__tracos") | safe }}<span class="titulo-secao__texto">{{ texto }}</span></h2>
    {% if sub %}<p class="secao__sub">{{ sub }}</p>{% endif %}
  </div>
  {% if link %}<a class="link-acao" href="{{ link }}">{{ textoLink }}{{ icone("arrow-right") | safe }}</a>{% endif %}
</div>
{% endmacro %}

{% macro cardVeiculo(v) %}
<article class="card-veiculo" data-chegada data-carroceria="{{ v.data.carroceria }}" data-marca="{{ v.data.marca | slug }}" data-ano="{{ v.data.ano }}" data-cambio="{{ v.data.cambio | slug }}" data-preco="{{ v.data.preco }}" data-km="{{ v.data.km }}" data-busca="{{ [v.data.marca, v.data.modelo, v.data.versao, v.data.anoTexto] | join(' ') | textoBusca }}">
  <div class="card-veiculo__quadro">
    {{ fotoVeiculo(v.page.fileSlug + "/01-capa.png", v.data.nome + " " + v.data.anoTexto + " (imagem ilustrativa)", "(min-width: 1360px) 330px, (min-width: 1024px) 24vw, (min-width: 768px) 46vw, 82vw") | safe }}
    <span class="card-veiculo__tracos" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="etiqueta">Imagem ilustrativa</span>
    <span class="selo selo--tipo">{{ v.data.carroceriaNome }}</span>
    {% if v.data.destaque %}<span class="selo selo--destaque">Destaque</span>{% endif %}
  </div>
  <div class="card-veiculo__corpo">
    <h3 class="card-veiculo__nome"><a href="{{ v.url }}">{{ v.data.nome }}</a></h3>
    <p class="card-veiculo__versao">{{ v.data.versao }}</p>
    <ul class="dados" aria-label="Resumo">
      <li>{{ icone("calendar") | safe }}{{ v.data.anoTexto }}</li>
      <li>{{ icone("gauge") | safe }}{{ v.data.km | numero }} km</li>
      {% if v.data.cambio %}<li>{{ icone("cog") | safe }}{{ v.data.cambio }}</li>{% endif %}
    </ul>
    <p class="card-veiculo__preco">{{ v.data.preco | reais }}</p>
    <a class="botao botao--primario card-veiculo__wa" href="{{ wa(v.data.mensagens.interesse) }}" target="_blank" rel="noopener" aria-label="Chamar no WhatsApp sobre o {{ v.data.nome }} {{ v.data.anoTexto }}">
      {{ icone("whatsapp") | safe }}<span aria-hidden="true">Chamar no WhatsApp</span>
    </a>
  </div>
</article>
{% endmacro %}

{% macro cardServico(c) %}
<a class="card-servico card-servico--{{ c.tom }}" href="{{ c.url }}">
  <span class="card-servico__fundo" aria-hidden="true">{{ ilustracao(c.imagem, "(min-width: 1024px) 34vw, 86vw") | safe }}</span>
  <span class="card-servico__texto">
    <span class="card-servico__icone">{{ icone(c.icone) | safe }}</span>
    <span class="card-servico__titulo">{{ c.titulo }}</span>
    <span class="card-servico__descricao">{{ c.texto }}</span>
    <span class="card-servico__acao">{{ c.acao }}{{ icone("arrow-right") | safe }}</span>
  </span>
</a>
{% endmacro %}

{#- Topo das páginas internas: faixa preta com trilha, título, texto e, se houver, a imagem ilustrativa à direita.
    Use com {% call topoPagina({...}) %} ... {% endcall %} para acrescentar botões ou dados abaixo do texto. -#}
{% macro topoPagina(t) %}
<section class="topo{% if not t.imagem %} topo--simples{% endif %}" aria-labelledby="titulo-pagina">
  <div class="envoltorio topo__grade">
    <div class="topo__texto">
      <nav class="trilha trilha--clara" aria-label="Trilha">
        <ol><li><a href="/">Início</a></li><li aria-current="page">{{ t.trilha or t.titulo }}</li></ol>
      </nav>
      <h1 class="topo__titulo" id="titulo-pagina">{{ t.titulo }}</h1>
      {% if t.lead %}<p class="topo__lead">{{ t.lead }}</p>{% endif %}
      {% if caller %}<div class="topo__extra">{{ caller() }}</div>{% endif %}
    </div>
    {%- if t.imagem %}
    <div class="topo__imagem">
      {{ tracos("topo__tracos") | safe }}
      <div class="topo__quadro">{{ ilustracao(t.imagem, "(min-width: 1024px) 40vw, 100vw", true) | safe }}</div>
    </div>
    {%- endif %}
  </div>
</section>
{% endmacro %}

{% macro passos(lista) %}
<ol class="passos passos--{{ lista.length }}">
  {%- for p in lista %}
  <li class="passo">
    <span class="passo__numero" aria-hidden="true">{{ loop.index }}</span>
    {{ icone(p.icone, "passo__icone") | safe }}
    <h3 class="passo__titulo">{{ p.titulo }}</h3>
    <p>{{ p.texto }}</p>
  </li>
  {%- endfor %}
</ol>
{% endmacro %}

{% macro quadroIlustracao(nome, sizes = "(min-width: 1024px) 40vw, 100vw", classe = "") %}
<div class="quadro-ia {{ classe }}">{{ ilustracao(nome, sizes) | safe }}</div>
{% endmacro %}
